# Variaveis NAO sensiveis da Execution em hml. Credenciais (JWT_SECRET) vem de Secrets criados pela
# pipeline a partir do Secrets Manager. O acesso ao DynamoDB e as filas e por IRSA, sem credencial.

# Carrega o dd-java-agent embarcado na imagem. Sobrescreve o JAVA_OPTS do Dockerfile, por isso o
# MaxRAMPercentage e repetido.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -javaagent:/app/dd-java-agent.jar

DD_ENV=hml
AMBIENTE=hml

# DD_VERSION e acrescentado pela pipeline (tag da imagem).
