# Variaveis NAO sensiveis da Execution em hml. Credenciais (JWT_SECRET, SERVICE_TOKEN) vem de Secrets criados pela
# pipeline a partir do Secrets Manager. O acesso ao DynamoDB e as filas e por IRSA, sem credencial.

# Carrega o dd-java-agent embarcado na imagem. Sobrescreve o JAVA_OPTS do Dockerfile, por isso o
# MaxRAMPercentage e repetido.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -javaagent:/app/dd-java-agent.jar

DD_ENV=hml
AMBIENTE=hml

# DD_VERSION e acrescentado pela pipeline (tag da imagem).

# Saga (ADR 0005): consome oficina-hml-execution-commands.fifo e responde em os-saga-replies, com as
# credenciais da Role IRSA.
MENSAGERIA_SQS_HABILITADO=true

# Tabelas oficina-hml-<nome> no DynamoDB (infra/dynamodb.tf); a regiao vem do AWS_REGION que o IRSA injeta.
# AMBIENTE (acima) e o prefixo das tabelas e das filas.

# Pronto para receber trafego so com o DynamoDB respondendo (DynamoDbHealthIndicator).
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,dynamoDb
